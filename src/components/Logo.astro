---
interface Props { compact?: boolean; inverse?: boolean; }
const { compact = false, inverse = false } = Astro.props;
---
<a href="/" class="inline-flex items-center gap-3 no-underline" aria-label="العودة إلى الصفحة الرئيسية">
  <svg viewBox="0 0 64 64" width="44" height="44" role="img" aria-label="شعار دليل منتزه الملك عبدالله">
    <rect width="64" height="64" rx="19" fill={inverse ? '#f7f1e5' : '#0b201a'} />
    <path d="M16 39c5-1 8-4 10-9 2 5 5 8 10 9 5-1 8-4 11-9" fill="none" stroke={inverse ? '#1d6b56' : '#b6e2d3'} stroke-width="3.2" stroke-linecap="round"/>
    <path d="M22 45h25" stroke={inverse ? '#1d6b56' : '#e5cda7'} stroke-width="3.2" stroke-linecap="round"/>
    <path d="M32 35V19m0 2c-5-5-10-3-12 1 5 0 9 2 12 6m0-7c5-5 10-3 12 1-5 0-9 2-12 6" fill="none" stroke={inverse ? '#0b201a' : '#e5cda7'} stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
  {!compact && <span class:list={["leading-tight", inverse ? "text-white" : "text-[#071713]"]}>
    <strong class="block text-[15px]">دليل منتزه الملك عبدالله</strong>
    <small class:list={["block text-[11px]", inverse ? "text-white/60" : "text-[#61716a]"]}>الملز · الرياض</small>
  </span>}
</a>
