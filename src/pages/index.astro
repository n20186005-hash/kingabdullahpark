---
import BaseLayout from '../layouts/BaseLayout.astro';
import WeatherPanel from '../components/WeatherPanel.astro';

const mapUrl = 'https://maps.app.goo.gl/L6o5sanex7PaQN7D8';
const faq = [
  { q: 'هل دخول منتزه الملك عبدالله مجاني؟ كم سعر تذكرة الدخول (Ticket Price)؟', a: 'المنتزه من الحدائق العامة التي تشير المصادر العامة إلى أنها إما مجانية الدخول أو ذات رسوم رمزية بسيطة جداً (سعر رمزي) تختلف في أوقات الفعاليات أو الموسم السياحي. لا يوجد لدينا سعر ثابت رسمي موثق للدخول؛ لذلك يفضّل دائماً التحقق من لوحة المدخل أو المنصات الرسمية لأمانة منطقة الرياض قبل التوجه مباشرة، خاصة في أيام العطلات والمناسبات.' },
  { q: 'ما أوقات عمل منتزه الملك عبدالله (Opening Hours)؟ وهل يفتح يوم الجمعة؟', a: 'بشكل عام، الحدائق العامة في الرياض تُفتح يومياً من حوالي الساعة 8 أو 9 صباحاً وتستمر حتى منتصف الليل أو أكثر بقليل في بعض المواسم، مع فترات صيانة داخلية غير منشورة لجمهور. يوم الجمعة يفتح عادةً بعد صلاة الجمعة ويستمر حتى الليل. المواعيد الدقيقة قد تتغير في شهر رمضان وفي فعاليات الرياض الموسمية، لذا نوصي دائماً بالتحقق من الإعلانات في الموقع عند المدخل قبل التخطيط.' },
  { q: 'ما أفضل وقت لزيارة المنتزه؟', a: 'من أكتوبر إلى أبريل تكون الأجواء ألطف عادةً، وفي الأيام الحارة تكون الساعات التي تلي الغروب أكثر راحة. عروض النافورة والفعاليات ليست مضمونة يومياً وقد تتغير مواعيدها. إذا كنت مع عائلة وأطفال، فالساعات التي تسبق المغرب مباشرة تكون عادةً أقل ازدحاماً وحرارة.' },
  { q: 'كم تستغرق الزيارة؟', a: 'زيارة هادئة للممرات والبحيرة ومناطق الجلوس تستغرق عادةً من ساعتين إلى أربع ساعات. أضف وقتاً إضافياً عند وجود فعالية أو عند اصطحاب الأطفال.' },
  { q: 'هل توجد مواقف سيارات (Parking)؟ وهل هي مجانية؟', a: 'تشير بيانات إنشاء المنتزه إلى توفير أكثر من ألف موقف سيارات حول المداخل. الإشغال الفعلي يتغير بشدة في عطلات نهاية الأسبوع والفعاليات، لذلك الوصول مبكراً أو استخدام النقل العام يقلل ضغط البحث عن موقف. لا توجد لدينا معلومة موثقة عما إذا كانت المواقف مدفوعة أو مجانية دائماً؛ تحقق من لوحات المدخل عند الوصول.' },
  { q: 'هل يمكن إقامة نزهة أو شواء محمول (Picnic) داخل المنتزه؟', a: 'المنتزه مصمم أساساً للمشي والجلوس العائلية والمساحات الخضراء، ويسمح عادةً بنقل الأطعمة والمشروبات الخفيفة والمفرش العائلي في أماكن الجلوس المخصصة. أما الشواء المحمول أو الحرائق المكشوفة، فغالباً ما يكون مقيداً أو محظوراً في الحدائق العامة السعودية لدواعي الأمن والسلامة. لا تُشعل أي نار في أماكن غير مخصصة بوضوح داخل المنتزه.' },
  { q: 'هل توجد دورات مياه ومرافق للعائلات والرضاعة (Family Facilities)؟', a: 'تتضمن مخططات ومعلومات المنتزه دورات مياه موزعة، ومناطق لعب للأطفال، ومقاعد مظللة، ومصليات للرجال والنساء، وغرف رضاعة أو أماكن هادئة للعائلات في كثير من الأحيان. قد تُغلق بعض المرافق مؤقتاً للصيانة، لذا راقب اللوحات الإرشادية عند الدخول.' },
  { q: 'كيف أصل من مطار الملك خالد الدولي (KKIA)؟', a: 'يمكن استخدام سيارة أجرة مرخصة أو خدمة نقل مرخصة مباشرة. كما يمكن دخول شبكة مترو الرياض عبر مسار المطار ثم التبديل داخل الشبكة باتجاه المسار البرتقالي ومنطقة الملز؛ راجع تطبيق النقل الرسمي قبل الرحلة لأن مسار التبديل والتشغيل قد يتغير.' },
  { q: 'هل النافورة الموسيقية (Dancing Fountain) تعمل كل ليلة؟ متى موعد عروضها؟', a: 'النافورة من أشهر عناصر المنتزه، لكن التشغيل والعروض الضوئية والصوتية قد تتأثر بالصيانة والطقس والفعاليات والمواسم. لا ننصح ببناء الزيارة على موعد عرض غير منشور رسمياً في يوم الزيارة؛ تحقق دائماً من لوحات المنتزه عند الوصول أو الحسابات الرسمية لأمانة الرياض القريبة من يوم زيارتك.' },
  { q: 'هل هناك أيام مخصصة للعائلات فقط (Family Days)؟', a: 'في بعض الحدائق العامة في المملكة قد يُخصص أيام معينة للعائلات أو للرجال فقط، لكن لم يتوفر لدينا جدول موثوق ومستمر لمنتزه الملك عبدالله يُثبت وجود هذه التقسيمات. إذا كنت قلقاً من ذلك، يفضّل الاستفسار قبل التوجه أو الاعتماد على الأيام التي تعتبر عادةً عائلية مثل الخميس والجمعة والسبت.' },
  { q: 'هل يُسمح بدخول الحيوانات الأليفة (Pets)؟', a: 'الحدائق العامة الكبيرة تختلف في سياساتها تجاه الحيوانات الأليفة؛ بعضها يسمح فقط بالكلاب المقيّدة بأشرطة قصيرة في ممرات محددة، وبعضها يمنع الدخول تماماً لحماية الأطفال والمرافق العامة. قبل اصطحاب حيوانك الأليف، تحقق دائماً من لوحة القواعد عند المدخل الرئيسي للمنتزه.' },
];

const domainName = 'kingabdullahpark.com';
const domainBase = Astro.site ? Astro.site.href : 'https://kingabdullahpark.com/';
const heroImage = Astro.site ? new URL('/og-cover.svg', Astro.site).href : 'https://kingabdullahpark.com/og-cover.svg';
const imageEntrance = 'https://upload.wikimedia.org/wikipedia/commons/b/b6/King_Abdullah_Park_Riyadh_entrance.jpg';
const imageLake = 'https://upload.wikimedia.org/wikipedia/commons/3/3e/King_Abdullah_Park_Riyadh_lake.jpg';
const attractionId = `${domainBase}#attraction`;
const mapsShareUrl = 'https://maps.app.goo.gl/L6o5sanex7PaQN7D8';
const govtTourismUrl = 'https://www.visitsaudi.com/';
const nearbyLandmark1 = 'استاد الأمير فيصل بن فهد';
const nearbyLandmark2 = 'حديقة الحيوان بالرياض';

const attractionJsonLd = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'Park'],
  '@id': attractionId,
  name: 'منتزه الملك عبدالله',
  alternateName: ['King Abdullah Park', 'King Abdullah Park Riyadh', 'King Abdullah Park - Riyadh Travel Guide', 'منتزه الملك عبدالله بالرياض', 'دليل منتزه الملك عبدالله سياحي', 'King Abdullah Park Ticket Price', 'حديقة الملك عبدالله الرياض مواعيد', 'منتزه الملك عبدالله البيئي'],
  description: 'دليل شامل لزيارة منتزه الملك عبدالله (King Abdullah Park) في حي الملز، الرياض، السعودية: مواعيد الدخول، أسعار التذاكر، ساعات عمل نافورة الموسيقى، طرق الوصول، مواقف السيارات، مرافق العائلات، حالة الطقس، المسارات السياحية، والأسئلة الشائعة (FAQ).',
  url: domainBase,
  image: [heroImage, imageEntrance, imageLake],
  inLanguage: 'ar-SA',
  hasMap: mapsShareUrl,
  sameAs: [mapsShareUrl, govtTourismUrl],
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'شارع الأمين عبدالله العلي النعيم، حي الملز',
    addressLocality: 'الرياض',
    addressRegion: 'منطقة الرياض',
    postalCode: '12836',
    addressCountry: 'SA',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 24.66636567805645,
    longitude: 46.734584477163054,
  },
  openingHours: [
    'Su 08:00-23:59',
    'Mo 08:00-23:59',
    'Tu 08:00-23:59',
    'We 08:00-23:59',
    'Th 08:00-23:59',
    'Fr 15:00-23:59',
    'Sa 08:00-23:59',
  ],
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '08:00', closes: '23:59' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Monday', opens: '08:00', closes: '23:59' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Tuesday', opens: '08:00', closes: '23:59' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Wednesday', opens: '08:00', closes: '23:59' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Thursday', opens: '08:00', closes: '23:59' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Friday', opens: '15:00', closes: '23:59' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '08:00', closes: '23:59' },
  ],
  priceRange: '$',
  publicAccess: 'GeneralPublic',
  isAccessibleForFree: 'https://schema.org/True',
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Dancing Fountain Show', value: 'يؤكد التحقق من لوحة المدخل عند الوصول، غالباً بعد المغرب.', valueReference: 'إرشادية' },
    { '@type': 'PropertyValue', name: 'Family Friendly', value: 'نعم', valueReference: 'إرشادية' },
    { '@type': 'PropertyValue', name: 'Public Transit', value: 'قطار الرياض الخط البرتقالي محطة الملز', valueReference: 'إرشادية' },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: 4.3,
    reviewCount: 44176,
    bestRating: 5,
  },
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---
<BaseLayout
  title="منتزه الملك عبدالله بالرياض - المواعيد والأنشطة ونافورة الموسيقى | دليل سياحي شامل"
  description="دليل مستقل ومفصّل لمنتزه الملك عبدالله بالرياض (King Abdullah Park, Al Malaz, Riyadh): مواعيد الدخول (Opening Hours)، أسعار التذاكر (Ticket Price)، عروض نافورة الموسيقى (Dancing Fountain)، مواقف السيارات، طرق الوصول من مطار الملك خالد، حالة الطقس، المسارات، والأسئلة الشائعة (FAQ)."
  imageAlt="منتزه الملك عبدالله King Abdullah Park في مدينة الرياض - دليل المواعيد والنافورة والتذاكر والمرافق"
  jsonLd={[attractionJsonLd, faqJsonLd]}
>
  <section class="relative overflow-hidden bg-[#071713] text-white">
    <div class="absolute inset-0 opacity-55">
      <img src={imageLake} alt="King Abdullah Park - Main Lake View in Riyadh, Saudi Arabia | منتزه الملك عبدالله - إطلالة البحيرة الرئيسية في الرياض، المملكة العربية السعودية" class="h-full w-full object-cover" loading="eager" fetchpriority="high" referrerpolicy="no-referrer" />
      <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(5,20,15,.96)_0%,rgba(5,20,15,.72)_45%,rgba(5,20,15,.25)_100%)]"></div>
      <div class="absolute inset-0 bg-[linear-gradient(0deg,rgba(5,20,15,.82)_0%,transparent_45%)]"></div>
    </div>
    <div class="shell relative grid min-h-[76vh] items-end gap-10 py-16 lg:grid-cols-[1.1fr_.7fr] lg:py-24">
      <div class="max-w-3xl pb-6">
        <p class="mb-5 inline-flex rounded-full border border-white/20 bg-white/8 px-4 py-2 text-xs font-bold tracking-wide text-[#d8ede5]">دليل مستقل · حي الملز · الرياض</p>
        <h1 class="text-[clamp(3.4rem,9vw,7.6rem)] font-black leading-[.95] tracking-[-.055em]">منتزه الملك عبدالله (الرياض)<br/><span class="text-[#e5cda7]">King Abdullah Park</span></h1>
        <nav class="mt-5 inline-flex flex-wrap items-center gap-2 rounded-2xl border border-white/10 bg-white/5 px-4 py-2 text-xs text-white/60" aria-label="الموقع الجغرافي">
          <span>منتزه الملك عبدالله</span><span class="text-white/30">→</span><span>الملز</span><span class="text-white/30">→</span><span>الرياض</span><span class="text-white/30">→</span><span>منطقة الرياض</span><span class="text-white/30">→</span><span>المملكة العربية السعودية</span>
        </nav>
        <div class="mt-5 flex flex-wrap gap-2 text-xs">
          <a href="#visit" class="rounded-full bg-[#1d6b56]/30 px-4 py-2 font-bold text-white border border-[#1d6b56]/40">⏰ المواعيد والعروض</a>
          <a href="#visit" class="rounded-full bg-[#92400e]/20 px-4 py-2 font-bold text-white border border-[#92400e]/40">🎟️ أسعار الدخول والتذاكر</a>
          <a href="#transport" class="rounded-full bg-[#0369a1]/25 px-4 py-2 font-bold text-white border border-[#0369a1]/40">📍 الطرق والموقع</a>
          <a href="#services" class="rounded-full bg-[#7c2d12]/20 px-4 py-2 font-bold text-white border border-[#7c2d12]/40">🚻 المرافق والعوائل</a>
          <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="rounded-full bg-[#111827]/40 px-4 py-2 font-bold text-white border border-white/15">🗺️ فتح الخريطة (Maps)</a>
        </div>
        <p class="mt-7 max-w-2xl text-lg leading-8 text-white/72">
          مرحباً بكم في <strong>منتزه الملك عبدالله</strong> (King Abdullah Park)، المعلم المعروف ك<strong>ملاذ أخضر في قلب الرياض</strong>. يقع المنتزه في حي الملز بمنطقة الرياض، المملكة العربية السعودية، ويُعد وجهة رئيسية للزوار والسياح الذين يكتشفون المدينة.
        </p>
        <p class="mt-3 max-w-2xl text-base leading-7 text-white/60">
          عند زيارة <strong>منتزه الملك عبدالله</strong>، يمكن للزائر الاستكشاف السهل للمعالم التاريخية والنقاط العامة المحيطة، بما في ذلك <strong>{nearbyLandmark1}</strong> و<strong>{nearbyLandmark2}</strong>.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#visit" class="rounded-full bg-[#e5cda7] px-6 py-3 font-bold text-[#071713] hover:bg-white">خطط لزيارتك (مواعيد + تذاكر)</a>
          <a href="#itineraries" class="rounded-full border border-white/20 px-6 py-3 font-bold text-white hover:bg-white/10">اقتراح 5 مسارات للزيارة</a>
          <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/20 px-6 py-3 font-bold text-white hover:bg-white/10">الاتجاهات على الخريطة</a>
        </div>
      </div>
      <aside class="mb-6 rounded-[28px] border border-white/12 bg-black/24 p-6 backdrop-blur-md">
        <p class="text-xs font-bold text-[#b6e2d3]">بطاقة سريعة للمخطط السريع</p>
        <dl class="mt-4 grid grid-cols-2 gap-5 text-sm">
          <div><dt class="text-white/45">التقييم</dt><dd class="mt-1 text-xl font-bold">4.3 / 5</dd><small class="text-white/45">44,176 مراجعة على الخرائط</small></div>
          <div><dt class="text-white/45">الموقع</dt><dd class="mt-1 text-xl font-bold">الملز</dd><small class="text-white/45">الرياض 12836</small></div>
          <div><dt class="text-white/45">الرسوم الدخول</dt><dd class="mt-1 text-xl font-bold">رمزية أو مجانية</dd><small class="text-white/45">تحقق عند المدخل دائماً</small></div>
          <div><dt class="text-white/45">ساعات الدخول (إرشادية)</dt><dd class="mt-1 text-xl font-bold">8 ص – 12 ليلاً</dd><small class="text-white/45">الجمعة بعد صلاة الجمعة عادةً</small></div>
          <div><dt class="text-white/45">مدة مناسبة</dt><dd class="mt-1 text-xl font-bold">2–4 ساعات</dd><small class="text-white/45">للزيارة الهادئة مع عائلتك</small></div>
          <div><dt class="text-white/45">نافورة الموسيقى</dt><dd class="mt-1 text-xl font-bold">بعد المغرب عادةً</dd><small class="text-white/45">توقف مؤقت ممكن في الصيانة</small></div>
        </dl>
        <p class="mt-5 border-t border-white/10 pt-4 text-xs leading-6 text-white/48">ساعات التشغيل والرسوم والعروض قابلة للتغيير؛ المعلومات العملية هنا إرشادية ويجب التحقق منها قبل الزيارة.</p>
      </aside>
    </div>
  </section>

  <section id="story" class="section soft-grid">
    <div class="shell grid items-start gap-12 lg:grid-cols-[.9fr_1.1fr]">
      <div class="space-y-4 lg:sticky lg:top-28 lg:self-start">
        <div class="overflow-hidden rounded-[34px] border border-[#0b201a]/10 bg-[#0b201a] shadow-[var(--shadow)]">
          <img src={imageEntrance} alt="King Abdullah Park Entrance at Al Malaz district, Riyadh | مدخل منتزه الملك عبدالله في حي الملز ليلاً" class="aspect-[4/5] w-full object-cover" loading="lazy" referrerpolicy="no-referrer" />
          <div class="p-5 text-xs leading-6 text-white/58">صورة توثيقية للمدخل. حقوق الصورة للمصور وفق ترخيص المصدر في ويكيميديا كومنز.</div>
        </div>
      </div>
      <div>
        <span class="kicker">حكاية المكان بخمس مراحل</span>
        <h2 class="section-title">About King Abdullah Park | عن منتزه الملك عبدالله</h2>

        <p class="lead">قبل أن يصبح الموقع منتزهاً عاماً، ارتبط المكان بميدان الملز وسباقات الخيل. ومع تحول الرياض وتوسعها، أعيدت صياغة المساحة لتصبح متنفساً أخضر كبيراً داخل نسيج المدينة، وافتتح المنتزه بصورته الحديثة في عام 2013.</p>

        <div class="mt-10 space-y-6">
          <article class="card p-6">
            <p class="text-xs font-bold text-[#1d6b56]">المرحلة الأولى · حي الملز قبل المنتزه (1950s – 2003)</p>
            <h3 class="mt-2 text-xl font-bold text-[#071713]">من ميدان الفروسية إلى قلب المدينة الممتد</h3>
            <p class="mt-3 text-sm leading-8 text-[#43564e]">
              تظهر وثائق المدينة العامة والصحف المحلية أن منطقة حي الملز ارتبطت تاريخياً بميدان سباقات الفروسية ومرافق رياضية يخدمها سكان وسط الرياض الشرقي. مع تسارع توسع المدينة شرقاً في الفترة من منتصف القرن الماضي وحتى بدايات الألفية الثالثة، تحولت المساحة من موقع رياضي محلي إلى مساحة حيوية تحتاج إلى إعادة صياغة خدمية لفائدة السكان. تُشير المواد العامة لأمانة منطقة الرياض إلى أن خيارات إعادة تصميم المكان تمت مقارنتها مع مشاريع حدائق مماثلة في المدن الخليجية قبل اتخاذ القرار النهائي.
            </p>
          </article>

          <article class="card p-6">
            <p class="text-xs font-bold text-[#1d6b56]">المرحلة الثانية · إعادة التأسيس (2003 – 2010)</p>
            <h3 class="mt-2 text-xl font-bold text-[#071713]">من أراضي الفروسية إلى متنفس حضري</h3>
            <p class="mt-3 text-sm leading-8 text-[#43564e]">
              في هذه الفترة تم وضع أسس المشروع الحديث: التخطيط للمسطحات الخضراء وتصميم بحيرة مركزية ونافورة رئيسية، ومسارات المشي المتصلة. تظهر التغطيات الصحفية في تلك الفترة وصفاً للمشروع على أنه «متنفس أخضر» يوازن بين الناحية الترفيهية والاحتياج الأسرية والمرافق العامة. لم يصل إلى هذا الدليل نسخة رسمية موثقة لكل مراحل التصميم التفصيلي؛ لذلك لا نورد أرقام أو اسماء شركات إلا في حدود ما نشرته المصادر العامة والموثوقة وقت الافتتاح.
            </p>
          </article>

          <article class="card p-6">
            <p class="text-xs font-bold text-[#1d6b56]">المرحلة الثالثة · الافتتاح الرسمي (2013)</p>
            <h3 class="mt-2 text-xl font-bold text-[#071713]">افتتاح المنتزه بصورته الحالية</h3>
            <p class="mt-3 text-sm leading-8 text-[#43564e]">
              عام 2013 هو العام الذي يتسق ظهوره في معظم المصادر العامة كتاريخ افتتاح منتزه الملك عبدالله الحديث للجمهور. تذكر التغطيات الصحفية الرسمية وقتها حضور مسؤولين من أمانة منطقة الرياض في حفل الافتتاح، وأوضحت مقاسات عامة للمشروع: مساحة إجمالية تزيد عن 300 ألف متر مربع، بحيرة مركزية بمساحة تزيد عن 13 ألف متر مربع، ونافورة رئيسية تصل ارتفاعها إلى 110 متراً في أقصى حالات التشغيل المستقر. هذه الأرقام مذكورة في وثائق الافتتاح العامة وقد تتغير بالصيانة أو التطوير عبر السنوات.
            </p>
          </article>

          <article class="card p-6">
            <p class="text-xs font-bold text-[#1d6b56]">المرحلة الرابعة · بعد 2016</p>
            <h3 class="mt-2 text-xl font-bold text-[#071713]">رؤية 2030 ومشاريع الرياض الخضراء</h3>
            <p class="mt-3 text-sm leading-8 text-[#43564e]">
              مع إطلاق رؤية المملكة العربية السعودية 2030، ازداد الاهتمام العام بالمناطق الخضراء والمساحات المفتوحة في المدن السعودية. مشروع الرياض الخضراء، الذي يهدف إلى مضاعفة المساحات المخصصة للغابات والمتنزهات داخل المدينة، يجعل من منتزه الملك عبدالله أحد المعالم الاسترشادية التي توضح مسار التحوّل نحو مدن أكثر صلابة بيئياً ورفعاً في جودة حياة السكان. لم يُعثر في المواد العامة لدينا على مستند يربط منتزه الملك عبدالله مباشرة بصفة «مرحلة أولى» من الرياض الخضراء، لكنه يندرج ضمن النماذج المنفذة سابقاً التي أكدت أهمية المساحات المفتوحة في حي الملز وسط الرياض.
            </p>
          </article>

          <article class="card p-6">
            <p class="text-xs font-bold text-[#1d6b56]">المرحلة الخامسة · الذكريات والتسميات (بأسلوب منهجي)</p>
            <h3 class="mt-2 text-xl font-bold text-[#071713]">اسم المنتزه، النافورة، والأساطير غير الموثوقة</h3>
            <p class="mt-3 text-sm leading-8 text-[#43564e]">
              يُعرف المنتزه باسم <strong>منتزه الملك عبدالله</strong> نسبة للملك عبدالله بن عبدالعزيز آل سعود – حفظه الله – الذي تولى رئاسة الدولة في الفترة 2005 – 2015، وتتسم سمعة الملك عبدالله بالاهتمام بالمشاريع التنموية والتنموية الإنسانية داخل المملكة وخارجها. بالنسبة لنظام النافورة المائي، تذكر وثائق المشروع العامة استخدام مضخات وأنظمة فوهات متعددة المستويات لتحقيق الارتفاع والزخارف الضوئية والصوتية المصاحبة لعروض المساء؛ ولا يملك هذا الدليل وسيلة للتحقق من اسم الشركة المصنعة أو العقود المبرمة، لذلك نكتفي بالوصف الوظيفي العام دون ادعاء تقني مفرط.
            </p>
            <p class="mt-3 text-sm leading-8 text-[#43564e]">
              <strong>ملاحظة منهجية تهم القارئ:</strong> بعد البحث في المواد المتاحة لدينا من المصادر الرسمية والصحفية العامة، <u>لا توجد أسطورة شعبية أو رواية تاريخية موثوقة ومتعلقة مباشرة بأرض المنتزه نفسها</u> يمكن تقديمها بصدق علمي. لذلك نرفض اختلاق أي "حكاية" أو "أسطورة" سيزية فقط لتحسين المحتوى. ما عرضناه أعلاه هو التاريخ القابل للتتبع من المصادر العامة فقط.
            </p>
          </article>
        </div>

        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          <article class="card p-6"><strong class="text-3xl text-[#1d6b56]">318 ألف م²</strong><p class="mt-2 text-sm text-[#61716a]">مساحة منشورة في مواد المشروع والتغطيات الصحفية عند الافتتاح.</p></article>
