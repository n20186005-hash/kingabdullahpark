---
import BaseLayout from '../layouts/BaseLayout.astro';
import WeatherPanel from '../components/WeatherPanel.astro';
import PhotoCredit from '../components/PhotoCredit.astro';
import SourceNotes from '../components/SourceNotes.astro';
import { mapsURL, mapEmbed, historyURL, faq, faqSchema, attractionSchema } from '../data/park';
const services=[
 ['دورات المياه','وردت في وصف الافتتاح. تحقق من المواقع المفتوحة، حالة الصيانة، الرسوم والحمامات المناسبة لاحتياجاتك.'],
 ['المصليات','ذكر وصف 2013 مصلى للرجال وآخر للنساء؛ لا نؤكد تشغيلهما اليوم. اسأل الإدارة عن المتاح.'],
 ['الطعام والمشروبات','تحقق من المقاهي أو منافذ البيع المفتوحة وأسعارها وشروط إدخال طعامك. لا نقدم توصية بمطعم محدد.'],
 ['الجلوس والظل','الجلسات جزء من وصف المشروع القديم؛ تحقق من الظل والاستراحات المتاحة ولا تعتمد على مقعد مضمون.'],
 ['ألعاب الأطفال','تأكد من فتح منطقة اللعب وملاءمتها للعمر وتعليمات استخدامها. توافرها وحالتها الحالية غير مفحوصين هنا.'],
 ['الوصول الحركي والسمعي والبصري','اسأل عن المدخل والممرات والخدمات التي تناسبك. لم نتحقق من كراسي للإعارة أو برايل أو وصف صوتي أو مسار وصول مُختبر.'],
 ['المواقف والإنزال','افحص تنظيم المواقف والتكلفة والمدخل المفتوح؛ قد تختلف ترتيبات يوم الفعالية.'],
 ['الإقامة','قارن الخيارات في المدينة بحسب احتياجاتك؛ لا نثبت مكان إقامة داخل المنتزه ولا نوصي بتاجر.'],
 ['التسوق والاحتياجات','خطط للمستلزمات قبل الذهاب، وتحقق مباشرة من أي متجر أو صيدلية تحتاجها وساعاتها. لا نضمن وجود متجر أو صيدلية أو صراف أو خدمة شحن داخل المنتزه.'],
 ['الأمن والمفقودات والإسعاف','تعرف على موظفي الإدارة ونقطة الاستفسار عند الدخول؛ لم نتحقق من مكتب مفقودات أو نقطة إسعاف تعمل اليوم. اطلب المساعدة من الجهات المختصة عند الحاجة.'],
 ['الوقود وشحن المركبات','تحقق من موقع الخدمة وتوافرها في مصدرها المباشر؛ لم نتحقق من نقطة وقود أو شحن بجوار بوابة معينة.']
];
const routes=[
 ['جولة عائلية','اختر جزءاً من الممرات والجلسات بعد تأكيد المرافق المفتوحة، واتفق على نقطة لقاء ووقت للعودة.'],
 ['التصوير الطبيعي','استكشف مشاهد الماء والنباتات من المناطق المسموحة. اطلب الإذن لتصوير الأشخاص؛ الصورة التاريخية لا تثبت منظر اليوم أو تشغيل النافورة.'],
 ['احتياج وصول أو مشي أقل','اسأل عن المدخل بلا درجات وعرض الممرات والحمام المناسب ومكان الاستراحة قبل السفر. لا نقدم مساراً ميسراً مُختبراً.'],
 ['خطة 3 ساعات','مثال لتوزيع وقتك بين الدخول والمشي والجلوس؛ عدّله بحسب الطقس وساعات اليوم. ليس مساراً مقاساً أو نشاطاً محجوزاً.'],
 ['خطة 6 ساعات','فكرة ليوم أطول مع فترات راحة أو زيارة منفصلة في المدينة. تحقق من كل وجهة ووسيلة انتقال وتذكرة على حدة؛ لا تُضمن زيارة الاستاد أو حديقة الحيوان مع تذكرة المنتزه.']
];
const seasons=[['الشتاء · ديسمبر–فبراير','قارن حرارة النهار والليل','ملابس يمكن تعديل طبقاتها','حدد طول الجولة وفق التوقعات واحتياجاتك.'],['الربيع · مارس–مايو','راقب تقلبات اليوم والتنبيهات','جهّز خيارات للرياح أو المطر عند توقعهما','لا تتنبأ الفصول بالازدحام أو بجاهزية الألعاب.'],['الصيف · يونيو–أغسطس','تحقق من الحرارة قبل الخروج','ماء وحماية من الشمس حسب الحاجة','عدّل موعد المشي أو أجّله وفق التنبيهات الرسمية.'],['الخريف · سبتمبر–نوفمبر','قد تختلف الظروف بين بداية الفصل ونهايته','طبقات مناسبة للموعد الفعلي','تحقق من أي فعالية معلنة؛ لا نفترض جدولاً موسمياً.']];
---
<BaseLayout title="منتزه الملك عبدالله بالملز، الرياض | المواعيد والموقع ودليل الزيارة" description="دليل مستقل لمنتزه الملك عبدالله في الملز بالرياض: مرجع ساعات مؤرخ، الموقع والوصول، ما يجب تأكيده عن التذاكر والنافورة والمرافق، الصور والطقس." jsonLd={[attractionSchema,faqSchema]}>
 <section class="relative overflow-hidden bg-[#071713] text-white">
  <div class="absolute inset-0 opacity-55"><img src="/images/park-lake.webp" alt="البحيرة الاصطناعية في منتزه الملك عبدالله بالرياض ليلاً، صورة عام 2022" class="h-full w-full object-cover" fetchpriority="high"/><div class="absolute inset-0 bg-black/60"></div></div>
  <div class="shell relative grid min-h-[76vh] items-end gap-10 py-16 lg:grid-cols-[1.1fr_.7fr] lg:py-24">
   <div class="min-w-0"><p class="kicker !text-[#b6e2d3]">دليل مستقل · حي الملز · الرياض</p><h1 class="mt-6 text-[clamp(2.6rem,7vw,6rem)] font-black leading-[1.2]">منتزه الملك عبدالله بالملز <span class="block text-[#e5cda7]">الرياض · King Abdullah Park</span></h1><p class="mt-6 max-w-2xl text-lg leading-8">بحيرة ومساحات خضراء وممرات في حي الملز. نميّز بين وصف المكان التاريخي والمعلومات التي تحتاج إلى تأكيد في يوم الزيارة، بما فيها رسوم الدخول وتشغيل النافورة.</p><div class="mt-8 flex flex-wrap gap-3"><a class="rounded-full bg-[#e5cda7] px-6 py-3 font-bold text-[#071713]" href="/visit/">خطط للزيارة</a><a class="rounded-full border border-white/40 px-6 py-3" href={mapsURL}>افتح موقع المنتزه</a><a class="rounded-full border border-white/40 px-6 py-3" href="#story">التاريخ والصور</a></div></div>
   <aside class="rounded-[28px] border border-white/20 bg-black/40 p-6"><h2 class="font-bold">قبل الخروج</h2><dl class="mt-4 space-y-4"><div><dt>مرجع ساعات الدخول</dt><dd class="font-bold">13:00–00:00 يومياً</dd><small>إدراج Maps · 22 أكتوبر 2026 UTC · أعد التحقق</small></div><div><dt>التذاكر والنافورة</dt><dd>لا سعر أو عرض حالي مؤكد هنا</dd></div><div><dt>العنوان</dt><dd>شارع الأمين عبدالله العلي النعيم، الملز، الرياض 12836</dd></div></dl></aside>
  </div>
  <div class="shell relative"><PhotoCredit image="lake"/></div>
 </section>
 <SourceNotes/>
 <section id="story" class="section soft-grid"><div class="shell grid gap-10 lg:grid-cols-2"><figure><img src="/images/park-entrance.webp" alt="مدخل منتزه الملك عبدالله في الرياض ليلاً، صورة عام 2023" width="1200" height="1200" class="w-full rounded-[30px]" loading="lazy"/><figcaption><PhotoCredit image="entrance"/></figcaption></figure><div><p class="kicker">التاريخ وأهمية المكان</p><h2 class="section-title">قراءة المكان من مصادر مؤرخة</h2><div class="space-y-5"><article class="card p-5"><h3 class="font-bold">هوية المنتزه</h3><p>المقصود هو منتزه الملز في الرياض، لا مشروع حدائق الملك عبدالله النباتية ولا منتزه آخر يحمل الاسم نفسه. طابق الموقع مع الخريطة قبل الانتقال.</p></article><article class="card p-5"><h3 class="font-bold">افتتاح 2013</h3><p>نشرت الجزيرة في 2 أكتوبر 2013 خبر الافتتاح، ناقلةً وصف أمين الرياض للمشروع. <a class="underline" href={historyURL}>اقرأ التغطية الأصلية</a>؛ هي مادة تاريخية وليست جدول تشغيل حالي.</p></article><article class="card p-5"><h3 class="font-bold">أرقام المشروع وقت الافتتاح</h3><p>وردت مساحة 318 ألف م²، وبحيرة تزيد على 13 ألف م²، ووصف لنافورة بارتفاع يتجاوز 110 م. لا تمثل الأرقام قياساً جديداً أو ضماناً لعرض اليوم.</p></article><article class="card p-5"><h3 class="font-bold">المرافق والفضاء العام</h3><p>وصفت التغطية ممرات وجلسات ولعب أطفال ومصليات ومرافق خدمية. تحقق من حالتها الحالية؛ وجودها في المخطط لا يثبت صلاحيتها أو فتحها الآن.</p></article><article class="card p-5"><h3 class="font-bold">الصور والذاكرة</h3><p>الصورتان تعودان إلى 2022 و2023 وتظهران البحيرة والمدخل. ليستا بثاً مباشراً، ولا تؤكدان أن الإنارة أو النافورة تعمل في موعد زيارتك.</p></article></div></div></div></section>
 <WeatherPanel/>
 <section id="seasonal" class="section bg-[#f7f1e5]"><div class="shell"><p class="kicker">التخطيط حسب الفصل</p><h2 class="section-title">أربعة فصول، والقرار لتوقعات يومك</h2><p class="lead">أفكار لتنظيم الزيارة وليست متوسطات حرارة موثقة للمنتزه أو توقعات للموسم الحالي. راجع <a class="underline" href="https://www.ncm.gov.sa/">المركز الوطني للأرصاد</a> والتنبيهات قبل السفر.</p><div class="mt-8 overflow-x-auto"><table class="w-full min-w-[680px] text-sm"><thead><tr>{['الفصل','التحقق','التجهيز','التخطيط'].map(x=><th class="p-4 text-right">{x}</th>)}</tr></thead><tbody>{seasons.map(row=><tr>{row.map(x=><td class="border-t border-[#0b201a]/15 p-4 align-top">{x}</td>)}</tr>)}</tbody></table></div></div></section>
 <section id="visit" class="section"><div class="shell"><p class="kicker">المواعيد والتذاكر والنافورة</p><h2 class="section-title">ثلاثة أسئلة قبل التوجه</h2><div class="mt-8 grid gap-5 md:grid-cols-3">{faq.slice(0,2).concat(faq[4]).map(x=><article class="card p-6"><h3 class="font-bold">{x.q}</h3><p class="mt-3">{x.a}</p></article>)}</div><a class="mt-6 inline-block underline" href="/visit/">تفاصيل الموقع والوصول والمواقف</a></div></section>
 <section id="transport" class="section bg-[#f7f1e5]"><div class="shell"><h2 class="section-title">الوصول إلى منتزه الملز</h2><div class="grid gap-5 md:grid-cols-2"><article class="card p-6"><h3 class="font-bold">من المطار أو بالنقل العام</h3><p>{faq[10].a}</p><a class="underline" href="https://www.rpt.sa/ar/home">درب · مخطط النقل الرسمي</a><p class="mt-3">للحافلات أو المترو، تحقق من الخط والمحطة والتبديل من المخطط الحالي؛ لا نؤكد رقم حافلة أو محطة ملز بعينها.</p></article><article class="card p-6"><h3 class="font-bold">بسيارة أو سيراً</h3><p>حدد بوابة مفتوحة ومكان إنزال مسموحاً، وتحقق من الطريق والعبور والطقس. دبوس الخريطة ليس بوابة موثقة أو مساراً ميسراً؛ لا نقدم وقت انتقال أو سعر نقل مضموناً.</p><a class="underline" href={mapsURL}>نقطة المنتزه على الخريطة</a></article></div></div></section>
 <section id="services" class="section"><div class="shell"><h2 id="visitor" class="section-title">المرافق والخدمات: ما الذي تسأل عنه؟</h2><p class="lead">أبقينا الموضوعات العملية منفصلة عن الوعود بالتوافر. بعض المرافق وردت في وصف 2013؛ الخدمات الحالية والأسعار وحالة الوصول تحتاج إلى تحقق مباشر.</p><div class="mt-8 grid gap-5 md:grid-cols-3">{services.map(([title,body])=><article class="card p-6"><h3 class="font-bold">{title}</h3><p class="mt-3">{body}</p></article>)}</div></div></section>
 <section id="itineraries" class="section bg-[#f7f1e5]"><div class="shell"><h2 class="section-title">خمسة اقتراحات لتنظيم وقتك</h2><p class="lead">مقترحات شخصية وليست جولات مقاسة أو ضماناً للدخول. الأنشطة في استاد الأمير فيصل بن فهد وحديقة الحيوان بالرياض زيارات منفصلة تتطلب تحققاً من مشغلها وتذاكرها؛ لا نفترض قرب بوابة مناسبة أو سهولة الربط مشياً.</p><div class="mt-8 grid gap-5 md:grid-cols-2">{routes.map(([title,body])=><article class="card p-6"><h3 class="font-bold">{title}</h3><p class="mt-3">{body}</p></article>)}</div></div></section>
 <section id="food" class="section bg-[#f7f1e5]"><div class="shell"><h2 class="section-title">الطعام: اختر النوع وتحقق من الخدمة</h2><p class="lead">فئات بحث لتنظيم وجبة قبل الزيارة أو بعدها، لا قائمة مطاعم مفحوصة ولا وعد بوجودها داخل المنتزه. تحقق من الموقع وساعات العمل وقواعد إدخال الطعام والتوصيل مباشرة.</p><div class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-4">{[['المطبخ السعودي والخليجي','قارن الوجبات والأسعار والحجم والموقع قبل اختيار مطعم.'],['وجبات خفيفة','اسأل عن المكونات وطريقة التحضير وما يلائم مجموعتك.'],['مقاهٍ ومخابز','تحقق من وقت الفتح ومكان الجلوس، ولا تفترض قبول إدخال المشتريات للفعالية.'],['احتياجات غذائية خاصة','أكد المكونات واحتمال التلامس مع مسببات الحساسية مباشرة مع مقدم الخدمة؛ لا يثبت وصف الفئة ملاءمة منتج معين.']].map(([t,b])=><article class="card p-6"><h3 class="font-bold">{t}</h3><p class="mt-3">{b}</p></article>)}</div></div></section>
 <section id="nearby" class="section"><div class="shell"><h2 class="section-title">وجهات أخرى للتخطيط المنفصل في الرياض</h2><p class="lead">أفكار لزيارة منفصلة تحتاج إلى بحث قبل تخصيص الوقت لها. لم تُفحص هنا ساعاتها أو تذاكرها أو مداخلها أو المسافة من بوابة المنتزه؛ لا نؤكد الجمع بينها في 3 أو 6 ساعات أو الربط بينها مشياً.</p><ul class="mt-6 grid gap-4 sm:grid-cols-2">{['استاد الأمير فيصل بن فهد','حديقة الحيوان بالرياض','مركز الملك عبدالعزيز التاريخي والمتحف الوطني','قصر المصمك والمنطقة التاريخية'].map(x=><li class="card p-5"><h3 class="font-bold">{x}</h3><p class="mt-2 text-sm">ابدأ بمصدر الجهة المشغلة للتحقق من الاسم والدخول والنقل في يومك؛ هذا اقتراح بحث لا توصية بخدمة أو تأكيد للتشغيل.</p></li>)}</ul></div></section>
 <section id="responsibility" class="section"><div class="shell rich-copy"><h2 class="section-title">الماء واحترام المكان وسلامة الزيارة</h2><p>ذكرت تغطية الافتتاح آباراً ومحطة تحلية ضمن تجهيز المشروع. لا نثبت من ذلك مصدر المياه أو نظام المعالجة اليوم، ولا نفترض أن مياه البحيرة صالحة للشرب أو السباحة. اتبع الحواجز واللوحات وتعليمات إدارة المنتزه.</p><ul><li>حافظ على المياه ولا تعبث بأنظمة الري أو النافورة.</li><li>اجمع النفايات واترك المسطحات والجلسات نظيفة.</li><li>احترم خصوصية العائلات واطلب إذناً قبل التصوير.</li><li>راقب الأطفال بالقرب من الماء والممرات ومناطق اللعب.</li><li>لا تُطعم الطيور أو الحيوانات؛ راقبها دون إزعاج.</li><li>خطط للحرارة والرياح، واتبع تنبيهات الجهات المختصة؛ توصيات الصفحة ليست إنذاراً رسمياً.</li><li>تحقق من قواعد الطعام والشواء والحيوانات قبل اصطحابها، ولا تفترض إذناً عاماً.</li></ul><p>هذه أفكار سلوك وزيارة، ولا تثبت اعتماد المنتزه ضمن مشروع آخر أو شهادة بيئية أو طبية.</p></div></section>
 <section id="map" class="section bg-[#f7f1e5]"><div class="shell"><h2 class="section-title">موقع منتزه الملك عبدالله في الملز</h2><p class="lead">الخريطة خدمة خارجية تتصل بجوجل عند تحميلها. استخدمها مع تأكيد البوابة المفتوحة.</p><iframe class="mt-6 w-full rounded-[28px]" src={mapEmbed} title="خريطة منتزه الملك عبدالله بالملز، الرياض" width="100%" height="480" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></div></section>
 <section id="faq" class="section"><div class="shell"><h2 class="section-title">أسئلة قبل الزيارة</h2><div class="mt-8 grid gap-4 lg:grid-cols-2">{faq.map(x=><details class="card p-6"><summary class="cursor-pointer font-bold">{x.q}</summary><p class="mt-4">{x.a}</p></details>)}</div><a class="mt-5 inline-block underline" href="/faq/">صفحة الأسئلة والأجوبة</a></div></section>
</BaseLayout>
