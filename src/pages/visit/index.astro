---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceNotes from '../../components/SourceNotes.astro';
import { faq, mapsURL, mapEmbed, attractionSchema } from '../../data/park';
const sections=[{id:'hours',title:'المواعيد والجمعة ورمضان',answer:faq[1].a},{id:'tickets',title:'التذاكر ورسوم الدخول',answer:faq[0].a},{id:'location',title:'الموقع الصحيح',answer:'شارع الأمين عبدالله العلي النعيم، حي الملز، الرياض 12836، وفق إدراج Maps في 22 أكتوبر 2026 (UTC). نقطة الساحة على الخريطة ليست تأكيداً لبوابة مفتوحة أو مدخل ميسر؛ طابق مكان الإنزال مع إدارة المنتزه.'},{id:'parking',title:'المواقف',answer:faq[2].a},{id:'transit',title:'من المطار وبالنقل العام',answer:faq[10].a},{id:'fountain',title:'النافورة والعروض',answer:faq[4].a}];
---
<BaseLayout title="زيارة منتزه الملك عبدالله بالملز | المواعيد والتذاكر والوصول" description="خطط لزيارة منتزه الملز بالرياض: مرجع ساعات الدخول المؤرخ، حدود معلومات التذاكر والنافورة، الموقع والمواقف وخيارات تخطيط الوصول." jsonLd={attractionSchema}>
 <section class="section soft-grid"><div class="shell"><p class="kicker">التخطيط للزيارة</p><h1 class="section-title">مواعيد منتزه الملك عبدالله بالملز والموقع والوصول</h1><p class="lead">جدول إدراج خارجي مؤرخ لا يضمن التشغيل اليوم. افصل بين ساعات الدخول ورسوم الفعاليات وجدول النافورة، وتحقق من احتياجات الوصول قبل السفر.</p><nav class="mt-8 flex flex-wrap gap-4" aria-label="أقسام الزيارة">{sections.map(x=><a class="underline" href={'#'+x.id}>{x.title}</a>)}</nav></div></section>
 <SourceNotes/>
 <div class="shell space-y-8 pb-16">{sections.map(x=><section id={x.id} class="card scroll-mt-28 p-6"><h2 class="text-2xl font-bold">{x.title}</h2><p class="mt-4">{x.answer}</p>{x.id==='hours'&&<p class="mt-3">مرجع Maps: جميع أيام الأسبوع 13:00 حتى 00:00 في بداية اليوم التالي؛ ليس برنامجاً متكرراً مضموناً أو تأكيداً لرمضان.</p>}{x.id==='transit'&&<a class="mt-3 inline-block underline" href="https://www.rpt.sa/ar/home">درب · مصدر تخطيط الرحلة</a>}</section>)}<section class="card p-6"><h2 class="text-2xl font-bold">الخريطة والتحقق الأخير</h2><p class="mt-4">أكد البوابة، المرافق المناسبة وحالة اليوم. لا نثبت مسار مشي بلا عوائق أو وقت انتقال من محطة بعينها.</p><a class="mt-3 inline-block underline" href={mapsURL}>الموقع على Google Maps</a><iframe src={mapEmbed} title="خريطة منتزه الملك عبدالله بالملز بالرياض" width="100%" height="420" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" class="mt-6 rounded-2xl"></iframe></section><a class="inline-block underline" href="/faq/">أسئلة الزوار</a></div>
</BaseLayout>
