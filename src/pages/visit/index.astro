---
import BaseLayout from '../../layouts/BaseLayout.astro';

const mapEmbed = 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6458.3861580959465!2d46.734584477163054!3d24.66636567805645!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3e2f043b45575437%3A0xa2bebdcec14359bd!2z6Zi_5biD5p2c5ouJ5Zu9546L5YWs5Zut!5e1!3m2!1sar!2ssa!4v1787621558586!5m2!1sar!2ssa';
const mapsShareUrl = 'https://maps.app.goo.gl/L6o5sanex7PaQN7D8';
const govtTourismUrl = 'https://www.visitsaudi.com/';

const weekHours = [
  { day: 'الأحد (Sunday)', opens: '08:00', closes: '23:59', note: 'مواعيد إرشادية' },
  { day: 'الاثنين (Monday)', opens: '08:00', closes: '23:59', note: 'مواعيد إرشادية' },
  { day: 'الثلاثاء (Tuesday)', opens: '08:00', closes: '23:59', note: 'مواعيد إرشادية' },
  { day: 'الأربعاء (Wednesday)', opens: '08:00', closes: '23:59', note: 'مواعيد إرشادية' },
  { day: 'الخميس (Thursday)', opens: '08:00', closes: '23:59', note: 'عطلة نهاية الأسبوع غالباً ما يزداد الزحام' },
  { day: 'الجمعة (Friday)', opens: '15:00', closes: '23:59', note: 'بعد صلاة الجمعة عادةً / تختلف في شهر رمضان' },
  { day: 'السبت (Saturday)', opens: '08:00', closes: '23:59', note: 'عطلة نهاية الأسبوع' },
];

const locationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  '@id': Astro.site ? `${Astro.site.href}visit/#attraction` : 'https://kingabdullahpark.com/visit/#attraction',
  name: 'منتزه الملك عبدالله بالرياض',
  alternateName: ['King Abdullah Park Riyadh', 'حديقة الملك عبدالله الملز'],
  description: 'صفحة التخطيط لزيارة منتزه الملك عبدالله: مواعيد الدخول، أسعار التذاكر، الموقع، خرائط الوصول، مواقف السيارات، النقل العام، ووقت عروض النافورة الموسيقية.',
  url: Astro.site ? new URL('/visit/', Astro.site).href : 'https://kingabdullahpark.com/visit/',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'شارع الأمين عبدالله العلي النعيم، حي الملز',
    addressLocality: 'الرياض',
    addressRegion: 'منطقة الرياض',
    postalCode: '12836',
    addressCountry: 'SA',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 24.66636567805645,
    longitude: 46.734584477163054,
  },
  openingHours: [
    'Su 08:00-23:59',
    'Mo 08:00-23:59',
    'Tu 08:00-23:59',
    'We 08:00-23:59',
    'Th 08:00-23:59',
    'Fr 15:00-23:59',
    'Sa 08:00-23:59',
  ],
  openingHoursSpecification: weekHours.map((row, i) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'][i],
    opens: row.opens,
    closes: row.closes,
  })),
  priceRange: '$',
  publicAccess: 'GeneralPublic',
  isAccessibleForFree: 'https://schema.org/True',
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: 4.3,
    reviewCount: 44176,
    bestRating: 5,
  },
  hasMap: mapsShareUrl,
  sameAs: [mapsShareUrl, govtTourismUrl],
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: Astro.site?.href || 'https://kingabdullahpark.com/' },
    { '@type': 'ListItem', position: 2, name: 'التخطيط للزيارة' },
  ],
};
---
<BaseLayout
  title="التخطيط لزيارة منتزه الملك عبدالله بالرياض - أسعار التذاكر ومواعيد الدخول والموقع | Visit Guide"
  description="دليل التخطيط لزيارة منتزه الملك عبدالله بالرياض (King Abdullah Park): مواعيد الدخول (Opening Hours) أيام الجمعة ورمضان، أسعار التذاكر (Ticket Price)، الموقع الدقيق على الخريطة، مواقف السيارات، طرق الوصول بالقطار والسيارة، وعروض نافورة الموسيقى."
  jsonLd={[locationJsonLd, breadcrumbJsonLd]}
>
  <section class="section soft-grid">
    <div class="shell space-y-12">
      <header class="space-y-5">
        <p class="kicker">التخطيط للزيارة · Visit Guide</p>
        <h1 class="section-title">مواعيد الدخول، أسعار التذاكر، والوصول إلى منتزه الملك عبدالله</h1>
        <p class="lead max-w-3xl">
          قبل التوجه إلى حي الملز بالرياض، راجع ما تحتاج لمعرفته: أوقات الفتح طوال الأسبوع، معلومات التذاكر والدخول، الموقع الدقيق، مواقف السيارات، كيفية الوصول، وأوقات عروض النافورة الموسيقية.
        </p>
      </header>

      <nav aria-label="أقسام التخطيط للزيارة" class="grid gap-3 rounded-[24px] border border-[#0b201a]/8 bg-[#071713]/[0.03] p-5 sm:grid-cols-2 lg:grid-cols-6">
        {[
          { h: '#hours', l: '⏰ مواعيد الدخول' },
          { h: '#tickets', l: '🎟️ التذاكر' },
          { h: '#location', l: '📍 الموقع والخريطة' },
          { h: '#parking', l: '🅿️ مواقف السيارات' },
          { h: '#transit', l: '🚇 النقل العام' },
          { h: '#fountain', l: '⛲ النافورة الموسيقية' },
        ].map((c) => (
          <a href={c.h} class="card flex items-center justify-between gap-2 px-4 py-4 text-xs font-bold text-[#0b201a] hover:-translate-y-[1px] hover:shadow-[var(--shadow)] lg:text-sm">
            <span>{c.l}</span><span class="text-[#1d6b56]">↓</span>
          </a>
        ))}
      </nav>

      <section id="hours" class="card p-6 lg:p-8 scroll-mt-28">
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <h2 class="text-2xl font-black text-[#071713] lg:text-3xl">⏰ مواعيد الدخول طوال الأسبوع (إرشادية)</h2>
          <span class="rounded-full bg-[#1d6b56]/10 px-3 py-1 text-xs font-bold text-[#1d6b56]">Opening Hours</span>
        </div>
        <p class="mt-3 leading-8 text-[#43564e]">
          المواعيد التالية مبنية على الممارسة العامة للحدائق الكبيرة في الرياض. قد تتغير الساعات في شهر رمضان، والمناسبات الوطنية، وفترات الصيانة؛ تحقق دائماً من لوحة المدخل أو القنوات الرسمية لأمانة الرياض قبل التوجه.
        </p>
        <div class="mt-6 overflow-hidden rounded-2xl border border-[#0b201a]/8">
          <table class="w-full text-sm text-right">
            <caption class="sr-only">جدول مواعيد الدخول الأسبوعية لمنتزه الملك عبدالله بالرياض</caption>
            <thead class="bg-[#0b201a] text-xs text-white">
              <tr>
                <th scope="col" class="px-5 py-4 font-bold">اليوم</th>
                <th scope="col" class="px-5 py-4 font-bold">فتح</th>
                <th scope="col" class="px-5 py-4 font-bold">إغلاق</th>
                <th scope="col" class="hidden px-5 py-4 font-bold sm:table-cell">ملاحظات</th>
              </tr>
            </thead>
            <tbody>
              {weekHours.map((row, i) => (
                <tr class:list={i % 2 === 0 ? ['bg-white'] : ['bg-[#0b201a]/[0.02]']}>
                  <th scope="row" class="px-5 py-4 text-left font-bold text-[#071713] sm:text-right">{row.day}</th>
                  <td class="px-5 py-4 font-black text-[#1d6b56]">{row.opens}</td>
                  <td class="px-5 py-4 font-black text-[#7c2d12]">{row.closes}</td>
                  <td class="hidden px-5 py-4 text-[#61716a] sm:table-cell">{row.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-4 text-xs leading-7 text-[#61716a]">
          ملاحظة خاصة ليوم الجمعة وشهر رمضان: قد يتم تأخير الافتتاح إلى ما بعد صلاة الجمعة، وفي رمضان غالباً ما تمتد ساعات التشغيل إلى أواخر الليل مع فعاليات خاصة.
        </p>
      </section>

      <section id="tickets" class="card p-6 lg:p-8 scroll-mt-28">
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <h2 class="text-2xl font-black text-[#071713] lg:text-3xl">🎟️ أسعار التذاكر والدخول (Ticket Price)</h2>
          <span class="rounded-full bg-[#92400e]/10 px-3 py-1 text-xs font-bold text-[#92400e]">Entry Fees</span>
        </div>
        <div class="mt-5 grid gap-5 lg:grid-cols-[1.1fr_.9fr]">
          <div class="space-y-4 leading-8 text-[#43564e]">
            <p>
              تشير المصادر العامة إلى أن منتزه الملك عبدالله يُصنف ضمن الحدائق العامة الكبرى في الرياض، والتي عادةً ما تكون
              <strong> إما مجانية الدخول تماماً أو برسوم رمزية بسيطة جداً </strong>
              في بعض المواسم أو فعاليات خاصة.
            </p>
            <ul class="space-y-2 pr-5 [list-style:disc]">
              <li>لم يتوفر لدينا جدول أسعار رسمي ومحدث من مصدر موثوق منفرد، لذلك <strong>لا نورد أرقام سعر ثابتة هنا</strong>.</li>
              <li>التحقق الأكثر موثوقية يكون دائماً من لوحة الأسعار عند المدخل الرئيسي أو المنصات الرسمية التابعة لأمانة منطقة الرياض.</li>
              <li>في أيام الفعاليات الكبرى أو فعاليات الرياض الموسمية، قد يُطبّق نظام تذاكر خاص أو أوقات دخول مختلفة.</li>
            </ul>
          </div>
          <aside class="rounded-[24px] border border-[#92400e]/20 bg-[#92400e]/[0.04] p-6 text-right">
            <p class="text-xs font-bold text-[#92400e]">ملخص سريع للتذاكر</p>
            <dl class="mt-4 space-y-4 text-sm">
              <div>
                <dt class="text-[#61716a]">نوع الدخول</dt>
                <dd class="mt-1 text-xl font-black text-[#071713]">مجاني / رسوم رمزية (غالباً)</dd>
              </div>
              <div>
                <dt class="text-[#61716a]">حجز مسبق</dt>
                <dd class="mt-1 text-xl font-black text-[#071713]">غير مطلوب عادةً للحدائق العامة</dd>
              </div>
              <div>
                <dt class="text-[#61716a]">أفضل استفسار</dt>
                <dd class="mt-1 text-xl font-black text-[#071713]">لوحة المدخل عند الوصول</dd>
              </div>
            </dl>
          </aside>
        </div>
      </section>

      <section id="location" class="card p-6 lg:p-8 scroll-mt-28">
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <h2 class="text-2xl font-black text-[#071713] lg:text-3xl">📍 الموقع الدقيق على الخريطة</h2>
          <span class="rounded-full bg-[#0369a1]/10 px-3 py-1 text-xs font-bold text-[#0369a1]">Location & Map</span>
        </div>
        <div class="mt-5 grid gap-5 lg:grid-cols-[1fr_1.2fr]">
          <div class="space-y-4 leading-8 text-[#43564e]">
            <p>
              يقع منتزه الملك عبدالله في حي <strong>الملز</strong> شرق وسط الرياض، على امتداد
              <strong> شارع الأمين عبدالله العلي النعيم </strong>
              . المنطقة سكنية وخدمية كثيفة ويسهل الوصول إليها من الطرق الرئيسية.
            </p>
            <dl class="space-y-3 rounded-2xl bg-[#0b201a]/[0.03] p-5 text-sm">
              <div class="flex flex-wrap items-start justify-between gap-2 border-b border-[#0b201a]/6 pb-3 last:border-none last:pb-0">
                <dt class="font-bold text-[#071713]">العنوان بالعربية</dt>
                <dd class="max-w-[70%] text-[#43564e]">شارع الأمين عبدالله العلي النعيم، حي الملز، الرياض 12836</dd>
              </div>
              <div class="flex flex-wrap items-start justify-between gap-2 border-b border-[#0b201a]/6 pb-3 last:border-none last:pb-0">
                <dt class="font-bold text-[#071713]">English Address</dt>
                <dd class="max-w-[70%] text-[#43564e]">Al Ameen Abdullah Al Ali Al Naeem St, Al Malaz, Riyadh 12836, Saudi Arabia</dd>
              </div>
              <div class="flex flex-wrap items-start justify-between gap-2 border-b border-[#0b201a]/6 pb-3 last:border-none last:pb-0">
                <dt class="font-bold text-[#071713]">الإحداثيات</dt>
                <dd class="max-w-[70%] text-[#43564e]">24.6664°N, 46.7346°E</dd>
              </div>
              <div class="flex flex-wrap items-start justify-between gap-2 last:border-none last:pb-0">
                <dt class="font-bold text-[#071713]">المنطقة الإدارية</dt>
                <dd class="max-w-[70%] text-[#43564e]">أمانة منطقة الرياض – بلدية الملك فيصل (غالباً)</dd>
              </div>
            </dl>
            <div class="flex flex-wrap gap-3">
              <a href={mapsShareUrl} target="_blank" rel="noopener noreferrer" class="rounded-full bg-[#0369a1] px-5 py-3 text-sm font-bold text-white hover:bg-[#075985]">فتح الخريطة في تطبيق خرائط جوجل</a>
              <a href="/faq/" class="rounded-full border border-[#0b201a]/15 px-5 py-3 text-sm font-bold text-[#071713] hover:bg-white">أسئلة حول الوصول</a>
            </div>
          </div>
          <div class="overflow-hidden rounded-2xl border border-[#0b201a]/8">
            <iframe
              title="موقع منتزه الملك عبدالله على خريطة جوجل – Al Malaz, Riyadh"
              src={mapEmbed}
              class="h-[440px] w-full"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        </div>
      </section>

      <section id="parking" class="card p-6 lg:p-8 scroll-mt-28">
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <h2 class="text-2xl font-black text-[#071713] lg:text-3xl">🅿️ مواقف السيارات (Parking)</h2>
          <span class="rounded-full bg-[#7c2d12]/10 px-3 py-1 text-xs font-bold text-[#7c2d12]">Parking Lots</span>
        </div>
        <div class="mt-5 grid gap-5 lg:grid-cols-3">
          <div class="lg:col-span-2 space-y-4 leading-8 text-[#43564e]">
            <p>
              تشير بيانات تصميم وإنشاء المنتزه إلى توفير <strong>أكثر من ألف موقف سيارات</strong> حول المداخل الرئيسية والفرعية. ومع ذلك فإن الإشغال الفعلي يتغير بشكل كبير حسب اليوم، والوقت، والفعاليات الجارية.
            </p>
            <ul class="space-y-2 pr-5 [list-style:disc]">
              <li>في عطلات نهاية الأسبوع (الخميس والجمعة والسبت) والمواسم السياحية، يمتلأ الموقف مبكراً جداً بعد الظهر.</li>
              <li>إذا لم تجد مكاناً، قد تضطر للبحث عن مواقف في الشوارع المجاورة داخل حي الملز؛ التزم بلوحات التنظيم وحدد المواقف المسموحة.</li>
              <li>لا توجد لدينا معلومة موثقة تُثبت أن جميع المواقف مجانية دائماً؛ تحقق من أجهزة Cobon أو لوحات الأسعار عند مدخل كل موقف.</li>
              <li>الوصول قبل العشاء بساعة أو أكثر يقلّل بشكل كبير من فرضية البحث الطويل عن مكان وقوف.</li>
            </ul>
          </div>
          <aside class="rounded-[24px] border border-[#7c2d12]/20 bg-[#7c2d12]/[0.04] p-6">
            <p class="text-xs font-bold text-[#7c2d12]">نصائح سريعة للوقوف</p>
            <ol class="mt-4 space-y-3 text-sm leading-7 text-[#43564e] [counter-reset:tip]">
              <li class="[counter-increment:tip]">
                <strong class="block text-[#071713]">الوصول مبكراً قبل الساعة 7 مساءً</strong>
                <span class="text-xs text-[#61716a]">[counter:tip]</span>
              </li>
              <li class="[counter-increment:tip]">
                <strong class="block text-[#071713]">اللجوء إلى النقل العام أو وسائل النقل المرخصة</strong>
                <span class="text-xs text-[#61716a]">[counter:tip]</span>
              </li>
              <li class="[counter-increment:tip]">
                <strong class="block text-[#071713]">تدوين رقم المدخل القريب الذي وقفت عنده</strong>
                <span class="text-xs text-[#61716a]">[counter:tip]</span>
              </li>
            </ol>
          </aside>
        </div>
      </section>

      <section id="transit" class="card p-6 lg:p-8 scroll-mt-28">
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <h2 class="text-2xl font-black text-[#071713] lg:text-3xl">🚇 الوصول بالنقل العام وسيارات الأجرة</h2>
          <span class="rounded-full bg-[#0369a1]/10 px-3 py-1 text-xs font-bold text-[#0369a1]">Public Transit</span>
        </div>
        <div class="mt-5 grid gap-5 lg:grid-cols-2">
          <div class="rounded-[24px] border border-[#0b201a]/8 bg-white p-6">
            <p class="text-xs font-bold text-[#0369a1]">قطار الرياض – الخط البرتقالي (Orange Line)</p>
            <h3 class="mt-2 text-xl font-black text-[#071713]">محطة الملز</h3>
            <p class="mt-3 leading-8 text-[#43564e]">
              تشير خطط شبكة قطار الرياض إلى أن <strong>المسار البرتقالي</strong> يخدم منطقة حي الملز. بعد النزول في المحطة القريبة، يمكن المشي على الأقدام أو ركوب وسيلة نقل مرخصة قصيرة المسافة إلى مدخل المنتزه حسب موقعك الدقيق في الشبكة.
            </p>
            <p class="mt-3 text-xs leading-7 text-[#61716a]">
              تجديد: مسارات الخطوط ومواقف المحطات قد تتغير مع مراحل التشغيل؛ راجع تطبيق النقل الرسمي لأمانة الرياض قبل الرحلة لتأكيد أقرب محطة.
            </p>
          </div>
          <div class="rounded-[24px] border border-[#0b201a]/8 bg-white p-6">
            <p class="text-xs font-bold text-[#7c2d12]">السيارات الخاصة وسيارات الأجرة المرخصة</p>
            <h3 class="mt-2 text-xl font-black text-[#071713]">الوصول من مطار KKIA ووسط الرياض</h3>
            <p class="mt-3 leading-8 text-[#43564e]">
              من <strong>مطار الملك خالد الدولي</strong>، يمكن استخدام سيارة أجرة مرخصة أو خدمة نقل مرخصة مباشرة إلى حي الملز. إذا كنت في وسط الرياض، فالوصول عادةً يتم عبر الطرق الدائرية الرئيسية باتجاه شرق المدينة، ثم الدخول إلى شبكة شوارع حي الملز.
            </p>
            <p class="mt-3 text-xs leading-7 text-[#61716a]">
              ننصح دائماً بتحديد الوجهة باسم المنتزه الكامل بالعربية والإنجليزية في تطبيقات الملاحة لتجنب الالتباس مع حدائق أو أحياء تحمل أسماء مشابهة.
            </p>
          </div>
        </div>
      </section>

      <section id="fountain" class="card p-6 lg:p-8 scroll-mt-28">
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <h2 class="text-2xl font-black text-[#071713] lg:text-3xl">⛲ عروض النافورة الموسيقية (Dancing Fountain)</h2>
          <span class="rounded-full bg-[#1d6b56]/10 px-3 py-1 text-xs font-bold text-[#1d6b56]">Fountain Shows</span>
        </div>
        <div class="mt-5 grid gap-5 lg:grid-cols-[1.1fr_.9fr]">
          <div class="space-y-4 leading-8 text-[#43564e]">
            <p>
              النافورة الموسيقية المعروضة فوق البحيرة من <strong>أبرز عناصر جذب المنتزه</strong>. العروض عادةً ما تجمع بين المياه المتحركة، والإضاءة الملونة، والمؤثرات الصوتية.
            </p>
            <ul class="space-y-2 pr-5 [list-style:disc]">
              <li><strong>التوقيت العام:</strong> غالباً ما تبدأ العروض بعد غروب الشمس مباشرة وتستمر بفواصل حتى منتصف الليل أو أقرب.</li>
              <li><strong>أسباب الإيقاف المؤقت:</strong> قد تتوقف العروض في أيام الصيانة، أو الأحوال الجوية القاسية، أو عند تداخل فعاليات كبرى في الرياض.</li>
              <li><strong>لا تبني رحلتك على موعد واحد:</strong> لا ننصح بتخطيط زيارة كاملة تعتمد فقط على موعد عرض نافورة محدد لم يتم نشره رسمياً في يوم زيارتك.</li>
            </ul>
          </div>
          <aside class="rounded-[24px] border border-[#1d6b56]/20 bg-gradient-to-br from-[#1d6b56]/[0.05] to-white p-6">
            <p class="text-xs font-bold text-[#1d6b56]">أفضل استراتيجية لمشاهدة النافورة</p>
            <ol class="mt-4 space-y-3 text-sm leading-7 text-[#43564e]">
              <li><strong class="text-[#071713]">١.</strong> تواصل مع المنتزه عبر القنوات الرسمية قبل يومين من الزيارة إن أمكن.</li>
              <li><strong class="text-[#071713]">٢.</strong> تواجد حول البحيرة قبل الغروب بـ ٢٠ دقيقة للحصول على مقعد جيد.</li>
              <li><strong class="text-[#071713]">٣.</strong> راقب لوحات المنتزه عند الدخول للتأكد من عدم وجود إيقاف مؤقت في نفس اليوم.</li>
              <li><strong class="text-[#071713]">٤.</strong> مع الأطفال: راقب الحبل الأمني حول البحيرة ولا تسمح بالقرب من حافة المياه.</li>
            </ol>
          </aside>
