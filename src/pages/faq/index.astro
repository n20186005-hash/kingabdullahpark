---
import BaseLayout from '../../layouts/BaseLayout.astro';

const faq = [
  {
    id: 'ticket-price',
    q: 'هل دخول منتزه الملك عبدالله مجاني؟ كم سعر تذكرة الدخول (Ticket Price)؟',
    category: 'التذاكر',
    a: 'المنتزه من الحدائق العامة التي تشير المصادر العامة إلى أنها إما مجانية الدخول أو ذات رسوم رمزية بسيطة جداً (سعر رمزي) تختلف في أوقات الفعاليات أو الموسم السياحي. لا يوجد لدينا سعر ثابت رسمي موثق للدخول؛ لذلك يفضّل دائماً التحقق من لوحة المدخل أو المنصات الرسمية لأمانة منطقة الرياض قبل التوجه مباشرة، خاصة في أيام العطلات والمناسبات.',
  },
  {
    id: 'opening-hours',
    q: 'ما أوقات عمل منتزه الملك عبدالله (Opening Hours)؟ وهل يفتح يوم الجمعة؟',
    category: 'المواعيد',
    a: 'بشكل عام، الحدائق العامة في الرياض تُفتح يومياً من حوالي الساعة 8 أو 9 صباحاً وتستمر حتى منتصف الليل أو أكثر بقليل في بعض المواسم، مع فترات صيانة داخلية غير منشورة لجمهور. يوم الجمعة يفتح عادةً بعد صلاة الجمعة ويستمر حتى الليل. المواعيد الدقيقة قد تتغير في شهر رمضان وفي فعاليات الرياض الموسمية، لذا نوصي دائماً بالتحقق من الإعلانات في الموقع عند المدخل قبل التخطيط.',
  },
  {
    id: 'parking',
    q: 'هل توجد مواقف سيارات (Parking)؟ وهل هي مجانية؟',
    category: 'الموقع',
    a: 'تشير بيانات إنشاء المنتزه إلى توفير أكثر من ألف موقف سيارات حول المداخل. الإشغال الفعلي يتغير بشدة في عطلات نهاية الأسبوع والفعاليات، لذلك الوصول مبكراً أو استخدام النقل العام يقلل ضغط البحث عن موقف. لا توجد لدينا معلومة موثقة عما إذا كانت المواقف مدفوعة أو مجانية دائماً؛ تحقق من لوحات المدخل عند الوصول.',
  },
  {
    id: 'family-facilities',
    q: 'هل توجد دورات مياه ومرافق للعائلات والرضاعة (Family Facilities)؟',
    category: 'المرافق',
    a: 'تتضمن مخططات ومعلومات المنتزه دورات مياه موزعة، ومناطق لعب للأطفال، ومقاعد مظللة، ومصليات للرجال والنساء، وغرف رضاعة أو أماكن هادئة للعائلات في كثير من الأحيان. قد تُغلق بعض المرافق مؤقتاً للصيانة، لذا راقب اللوحات الإرشادية عند الدخول.',
  },
  {
    id: 'dancing-fountain',
    q: 'هل النافورة الموسيقية (Dancing Fountain) تعمل كل ليلة؟ متى موعد عروضها؟',
    category: 'المرافق',
    a: 'النافورة من أشهر عناصر المنتزه، لكن التشغيل والعروض الضوئية والصوتية قد تتأثر بالصيانة والطقس والفعاليات والمواسم. لا ننصح ببناء الزيارة على موعد عرض غير منشور رسمياً في يوم الزيارة؛ تحقق دائماً من لوحات المنتزه عند الوصول أو الحسابات الرسمية لأمانة الرياض القريبة من يوم زيارتك.',
  },
  {
    id: 'best-time',
    q: 'ما أفضل وقت لزيارة المنتزه؟',
    category: 'التخطيط',
    a: 'من أكتوبر إلى أبريل تكون الأجواء ألطف عادةً، وفي الأيام الحارة تكون الساعات التي تلي الغروب أكثر راحة. عروض النافورة والفعاليات ليست مضمونة يومياً وقد تتغير مواعيدها. إذا كنت مع عائلة وأطفال، فالساعات التي تسبق المغرب مباشرة تكون عادةً أقل ازدحاماً وحرارة.',
  },
  {
    id: 'duration',
    q: 'كم تستغرق الزيارة؟',
    category: 'التخطيط',
    a: 'زيارة هادئة للممرات والبحيرة ومناطق الجلوس تستغرق عادةً من ساعتين إلى أربع ساعات. أضف وقتاً إضافياً عند وجود فعالية أو عند اصطحاب الأطفال.',
  },
  {
    id: 'picnic-bbq',
    q: 'هل يمكن إقامة نزهة أو شواء محمول (Picnic) داخل المنتزه؟',
    category: 'المرافق',
    a: 'المنتزه مصمم أساساً للمشي والجلوس العائلية والمساحات الخضراء، ويسمح عادةً بنقل الأطعمة والمشروبات الخفيفة والمفرش العائلي في أماكن الجلوس المخصصة. أما الشواء المحمول أو الحرائق المكشوفة، فغالباً ما يكون مقيداً أو محظوراً في الحدائق العامة السعودية لدواعي الأمن والسلامة. لا تُشعل أي نار في أماكن غير مخصصة بوضوح داخل المنتزه.',
  },
  {
    id: 'family-days',
    q: 'هل هناك أيام مخصصة للعائلات فقط (Family Days)؟',
    category: 'المرافق',
    a: 'في بعض الحدائق العامة في المملكة قد يُخصص أيام معينة للعائلات أو للرجال فقط، لكن لم يتوفر لدينا جدول موثوق ومستمر لمنتزه الملك عبدالله يُثبت وجود هذه التقسيمات. إذا كنت قلقاً من ذلك، يفضّل الاستفسار قبل التوجه أو الاعتماد على الأيام التي تعتبر عادةً عائلية مثل الخميس والجمعة والسبت.',
  },
  {
    id: 'pets',
    q: 'هل يُسمح بدخول الحيوانات الأليفة (Pets)؟',
    category: 'المرافق',
    a: 'الحدائق العامة الكبيرة تختلف في سياساتها تجاه الحيوانات الأليفة؛ بعضها يسمح فقط بالكلاب المقيّدة بأشرطة قصيرة في ممرات محددة، وبعضها يمنع الدخول تماماً لحماية الأطفال والمرافق العامة. قبل اصطحاب حيوانك الأليف، تحقق دائماً من لوحة القواعد عند المدخل الرئيسي للمنتزه.',
  },
  {
    id: 'kkiia',
    q: 'كيف أصل من مطار الملك خالد الدولي (KKIA)؟',
    category: 'الموقع',
    a: 'يمكن استخدام سيارة أجرة مرخصة أو خدمة نقل مرخصة مباشرة. كما يمكن دخول شبكة مترو الرياض عبر مسار المطار ثم التبديل داخل الشبكة باتجاه المسار البرتقالي ومنطقة الملز؛ راجع تطبيق النقل الرسمي قبل الرحلة لأن مسار التبديل والتشغيل قد يتغير.',
  },
];

const categories = [
  { key: 'التذاكر', href: '#ticket-price', label: '🎟️ أسعار التذاكر' },
  { key: 'المواعيد', href: '#opening-hours', label: '⏰ مواعيد الدخول' },
  { key: 'الموقع', href: '#parking', label: '📍 الموقع والمواقف' },
  { key: 'المرافق', href: '#family-facilities', label: '🚻 مرافق العائلات' },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const pageJsonLd = {
  '@context': 'https://schema.org',
  '@type': ['WebPage', 'CollectionPage'],
  name: 'الأسئلة الشائعة – منتزه الملك عبدالله بالرياض | King Abdullah Park FAQ',
  description: 'إجابات عن أسعار التذاكر، مواعيد الدخول، مواقف السيارات، مرافق العائلات، نافورة الموسيقى، قواعد النزهات، وكيفية الوصول إلى منتزه الملك عبدالله في الرياض.',
  inLanguage: 'ar-SA',
  isPartOf: { '@id': Astro.site ? `${Astro.site.href}#attraction` : 'https://kingabdullahpark.com/#attraction' },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: Astro.site?.href || 'https://kingabdullahpark.com/' },
      { '@type': 'ListItem', position: 2, name: 'الأسئلة الشائعة' },
    ],
  },
};
---
<BaseLayout
  title="الأسئلة الشائعة لمنتزه الملك عبدالله بالرياض - أسعار التذاكر والمواعيد | دليل FAQ شامل"
  description="إجابات شائعة عن منتزه الملك عبدالله بالرياض (King Abdullah Park FAQ): هل الدخول مجاني؟ كم Ticket Price؟ ما أوقات الدخول (Opening Hours) أيام الجمعة ورمضان؟ مواقف السيارات، النافورة الموسيقية، قواعد النزهات، الحيوانات الأليفة، وكيفية الوصول."
  jsonLd={[pageJsonLd, faqJsonLd]}
>
  <section class="section soft-grid">
    <div class="shell space-y-10">
      <div class="space-y-5">
        <p class="kicker">الأسئلة الشائعة · FAQ</p>
        <h1 class="section-title">أسئلة الزوار الأكثر شيوعاً عن منتزه الملك عبدالله</h1>
        <p class="lead max-w-3xl">
          جمعنا لك أكثر الأسئلة تكراراً لدى خطط زيارة منتزه الملك عبدالله في حي الملز بالرياض: من سعر التذكرة وأوقات الدخول، إلى مواقف السيارات، ونافورة الموسيقى، ومرافق العائلات، وكيفية الوصول.
        </p>
      </div>

      <nav aria-label="الأقسام الرئيسية للأسئلة الشائعة" class="grid gap-3 rounded-[24px] border border-[#0b201a]/8 bg-[#071713]/[0.03] p-5 sm:grid-cols-2 lg:grid-cols-4">
        {categories.map((c) => (
          <a
            href={c.href}
            class="card flex items-center justify-between gap-3 px-5 py-4 text-sm font-bold text-[#0b201a] hover:-translate-y-[1px] hover:shadow-[var(--shadow)]"
          >
            <span>{c.label}</span>
            <span class="text-[#1d6b56]">↓</span>
          </a>
        ))}
      </nav>

      <div class="space-y-5">
        {faq.map((item) => (
          <article id={item.id} class="card p-6 lg:p-8 scroll-mt-28">
            <div class="flex flex-wrap items-center gap-3">
              <span class="rounded-full bg-[#1d6b56]/10 px-3 py-1 text-xs font-bold text-[#1d6b56]">{item.category}</span>
            </div>
            <h2 class="mt-3 text-xl font-black leading-9 text-[#071713] lg:text-2xl">{item.q}</h2>
            <p class="mt-4 text-base leading-8 text-[#43564e]">{item.a}</p>
          </article>
        ))}
      </div>

      <div class="rounded-[28px] border border-[#0b201a]/8 bg-gradient-to-br from-[#0b201a]/[0.04] to-white p-7 lg:p-10">
        <h2 class="text-2xl font-black text-[#071713] lg:text-3xl">هل تحتاج إلى مزيد من التفاصيل قبل زيارتك؟</h2>
        <p class="mt-3 max-w-3xl leading-8 text-[#43564e]">
          راجع صفحة التخطيط الكاملة للزيارة للحصول على جدول مواعيد الدخول الأسبوعي، خرائط الموقع، مواقف السيارات، وطرق الوصول بالقطار والسيارة.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/visit/" class="rounded-full bg-[#0b201a] px-6 py-3 font-bold text-white hover:bg-[#1d6b56]">التخطيط للزيارة كاملة</a>
          <a href="/" class="rounded-full border border-[#0b201a]/15 px-6 py-3 font-bold text-[#071713] hover:bg-white">العودة إلى الصفحة الرئيسية</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
